# Copy this file as .env and adjust the values. Never commit the real .env.
# DB_ENGINE chooses the engine: sqlite or mysql (the code does not change).
DB_ENGINE=sqlite
SQLITE_PATH=viajes_aventura.db

# MySQL 8.0.16 or newer. Create the database first: CREATE DATABASE viajes_aventura;
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=viajes_aventura

# First administrator, created when the program starts and there is no admin yet.
# Password: at least 8 characters, with letters and numbers.
ADMIN_EMAIL=admin@viajesaventura.cl
ADMIN_PASSWORD=

# Password for every user of the sample data (python init_db.py --seed).
SEED_PASSWORD=

# Optional: a separate, empty MySQL database for the automatic tests.
# The tests DROP its tables, so never point it at the real database.
# MYSQL_TEST_DATABASE=viajes_aventura_test
